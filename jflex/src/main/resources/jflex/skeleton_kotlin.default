  /**
   * Creates a new scanner reading from [reader].
   *
   * @param reader the input to scan.
   */
  constructor(reader: kotlinx.io.Source) {
    this.zzReader = reader
    // Establishes the initial position state. KotlinEmitter emits no constructor, so for a
    // standalone skeleton this is the only place to do it.
    yyResetPosition()
  }

--- 5. constructor declaration (unused: KotlinEmitter emits no constructor)

  /**
   * Refills the input buffer.
   *
   * @return `false` iff there was new input.
   * @throws kotlinx.io.IOException if any I/O error occurs.
   */
  @Throws(kotlinx.io.IOException::class)
  private fun zzRefill(): Boolean {

    /* first: make room (if you can) */
    if (zzStartRead > 0) {
      zzBuffer.copyInto(zzBuffer, 0, zzStartRead, zzEndRead)

      /* translate stored positions */
      zzEndRead -= zzStartRead
      zzCurrentPos -= zzStartRead
      zzMarkedPos -= zzStartRead
      zzStartRead = 0
    }

    /* is the buffer big enough? */
    if (zzCurrentPos >= zzBuffer.size && zzCanGrow()) {
      /* if not, and it can grow: blow it up */
      val newBuffer = CharArray(kotlin.math.min(zzBuffer.size * 2, zzMaxBufferLen()))
      zzBuffer.copyInto(newBuffer, 0, 0, zzBuffer.size)
      zzBuffer = newBuffer
    }

    /* fill the buffer with new input */
    val requested: Int = zzBuffer.size - zzEndRead
    if (requested == 0) {
      throw kotlinx.io.EOFException("Scan buffer limit reached [" + zzBuffer.size + "]")
    }

    val numRead: Int = zzReadChars(zzBuffer, zzEndRead, requested)
    if (numRead > 0) {
      zzEndRead += numRead
      /* potentially more input available */
      return false
    }

    /* numRead < 0 ==> end of stream */
    return true
  }

  /**
   * Decodes UTF-8 input from [zzReader] into UTF-16 code units.
   *
   * Reads at most [count] code units into [target], starting at [offset]. A supplementary code
   * point that would not fit whole is held in [zzPendingCodePoint] and delivered on the next call,
   * so a surrogate pair is never split across a buffer boundary.
   *
   * @return the number of code units read, or -1 at end of input.
   * @throws kotlinx.io.IOException if any I/O error occurs.
   */
  @Throws(kotlinx.io.IOException::class)
  private fun zzReadChars(target: CharArray, offset: Int, count: Int): Int {
    var written = 0

    while (written < count) {
      val codePoint: Int
      if (zzPendingCodePoint >= 0) {
        codePoint = zzPendingCodePoint
        zzPendingCodePoint = -1
      } else {
        if (zzReader.exhausted()) {
          break
        }
        codePoint = zzReadCodePoint()
      }

      if (charCount(codePoint) == 1) {
        target[offset + written] = codePoint.toChar()
        written++
      } else if (written + 2 <= count) {
        val value: Int = codePoint - 0x10000
        target[offset + written] = (0xD800 + (value shr 10)).toChar()
        target[offset + written + 1] = (0xDC00 + (value and 0x3FF)).toChar()
        written += 2
      } else if (written > 0) {
        /* Only one free position left: keep the code point whole for the next refill, so that the
           buffer does not end in a lone high surrogate. */
        zzPendingCodePoint = codePoint
        break
      } else {
        /* count == 1, so a pair can never fit. Split rather than stall; a buffer this small cannot
           represent supplementary code points faithfully. */
        val value: Int = codePoint - 0x10000
        target[offset] = (0xD800 + (value shr 10)).toChar()
        zzPendingCodePoint = 0xDC00 + (value and 0x3FF)
        written = 1
        break
      }
    }

    return if (written == 0) -1 else written
  }

  /**
   * Reads one UTF-8 encoded code point from [zzReader].
   *
   * Malformed input is mapped to U+FFFD rather than reported, matching a lenient decoder. Callers
   * must have established that the source is not exhausted.
   *
   * @return the code point read.
   * @throws kotlinx.io.IOException if any I/O error occurs.
   */
  @Throws(kotlinx.io.IOException::class)
  private fun zzReadCodePoint(): Int {
    val b0: Int = zzReader.readByte().toInt() and 0xFF
    if (b0 < 0x80) {
      return b0
    }

    val extraBytes: Int = when {
      (b0 and 0xE0) == 0xC0 -> 1
      (b0 and 0xF0) == 0xE0 -> 2
      (b0 and 0xF8) == 0xF0 -> 3
      else -> return 0xFFFD
    }

    var codePoint: Int = b0 and (0x3F shr extraBytes)
    for (i in 0 until extraBytes) {
      if (zzReader.exhausted()) {
        return 0xFFFD
      }
      val b: Int = zzReader.readByte().toInt() and 0xFF
      if ((b and 0xC0) != 0x80) {
        return 0xFFFD
      }
      codePoint = (codePoint shl 6) or (b and 0x3F)
    }
    return codePoint
  }

  /**
   * Closes the input source.
   *
   * @throws kotlinx.io.IOException if the source could not be closed.
   */
  @Throws(kotlinx.io.IOException::class)
  fun yyclose() {
    zzAtEOF = true          // indicate end of file
    zzEndRead = zzStartRead // invalidate buffer
    zzReader.close()
  }

  /**
   * Resets the scanner to read from a new input source.
   *
   * Does not close the old source. All internal variables are reset, the old input source
   * **cannot** be reused (the internal buffer is discarded and lost). Lexical state is set to
   * `ZZ_INITIAL`. The internal scan buffer is resized down to its initial length, if it has grown.
   *
   * @param reader the new input source.
   */
  fun yyreset(reader: kotlinx.io.Source) {
    zzReader = reader
    zzEOFDone = false
    yyResetPosition()
    zzLexicalState = YYINITIAL
    val initBufferSize: Int = kotlin.math.min(ZZ_BUFFERSIZE, zzMaxBufferLen())
    if (zzBuffer.size > initBufferSize) {
      zzBuffer = CharArray(initBufferSize)
    }
  }

  /** Resets the input position. */
  private fun yyResetPosition() {
    zzAtBOL = true
    zzAtEOF = false
    zzCurrentPos = 0
    zzMarkedPos = 0
    zzStartRead = 0
    zzEndRead = 0
    zzPendingCodePoint = -1
    yyline = 0
    yycolumn = 0
    yychar = 0L
  }

  /**
   * Returns whether the scanner has reached the end of the source it reads from.
   *
   * @return whether the scanner has reached EOF.
   */
  fun yyatEOF(): Boolean {
    return zzAtEOF
  }

  /**
   * Returns the current lexical state.
   *
   * @return the current lexical state.
   */
  fun yystate(): Int {
    return zzLexicalState
  }

  /**
   * Enters a new lexical state.
   *
   * @param newState the new lexical state.
   */
  fun yybegin(newState: Int) {
    zzLexicalState = newState
  }

  /**
   * Returns the text matched by the current regular expression.
   *
   * @return the matched text.
   */
  fun yytext(): String {
    return String(zzBuffer, zzStartRead, zzMarkedPos - zzStartRead)
  }

  /**
   * Returns the character at the given position from the matched text.
   *
   * It is equivalent to `yytext()[position]`, but faster.
   *
   * @param position the position of the character to fetch. A value from 0 to `yylength()-1`.
   * @return the character at [position].
   */
  fun yycharat(position: Int): Char {
    return zzBuffer[zzStartRead + position]
  }

  /**
   * How many characters were matched.
   *
   * @return the length of the matched text region.
   */
  fun yylength(): Int {
    return zzMarkedPos - zzStartRead
  }

  /** Converts a UTF-16 surrogate pair to a Unicode code point. */
  private fun zzToCodePoint(high: Char, low: Char): Int {
    // UTF-16 high surrogate: 110110xxxxxxxxxx (10 bits)
    // UTF-16 low surrogate:  110111yyyyyyyyyy (10 bits)
    // Code point: 0x10000 + xxxxxxxxxxyyyyyyyyyy (21 bits)
    return ((high.code - 0xD800) shl 10) + (low.code - 0xDC00) + 0x10000
  }

  /**
   * Number of UTF-16 code units needed to represent [codePoint].
   *
   * Stands in for `java.lang.Character.charCount`, which is not available in common Kotlin.
   */
  private fun charCount(codePoint: Int): Int = if (codePoint < 0x10000) 1 else 2

  /**
   * Length of the scan buffer, so that generated code can treat it like a `CharSequence`.
   *
   * Only the general-lookahead code path uses this.
   */
  private val CharArray.length: Int
    get() = size

  /**
   * Stands in for `java.lang.Character.codePointAt` on the scan buffer.
   *
   * @param index the index of the character for which to retrieve the code point.
   * @return the Unicode code point at [index].
   */
  private fun CharArray.codePoint(index: Int): Int {
    val high = this[index]
    if (high.isHighSurrogate() && index + 1 < size) {
      val low = this[index + 1]
      if (low.isLowSurrogate()) {
        return zzToCodePoint(high, low)
      }
    }
    return high.code
  }

  /**
   * Stands in for `java.lang.Character.codePointBefore` on the scan buffer.
   *
   * @param index the index following the code point to return.
   * @return the Unicode code point before [index].
   */
  private fun CharArray.codePointBefore(index: Int): Int {
    val low = this[index - 1]
    if (low.isLowSurrogate() && index - 2 >= 0) {
      val high = this[index - 2]
      if (high.isHighSurrogate()) {
        return zzToCodePoint(high, low)
      }
    }
    return low.code
  }

  /**
   * Stands in for `java.lang.String.offsetByCodePoints` on the scan buffer.
   *
   * Used by the fixed-length lookahead code paths.
   *
   * @param index the index to start from.
   * @param codePointOffset the number of code points to move; may be negative.
   * @return the resulting index.
   */
  private fun CharArray.offsetByCodePoints(index: Int, codePointOffset: Int): Int {
    var result = index
    if (codePointOffset >= 0) {
      for (i in 0 until codePointOffset) {
        result += charCount(this.codePoint(result))
      }
    } else {
      for (i in 0 until -codePointOffset) {
        result -= charCount(this.codePointBefore(result))
      }
    }
    return result
  }

